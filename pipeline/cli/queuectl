#!/home/pipeline-stable/.conda/envs/pipeline/bin/python
"""
queuectl — control the reduction queue on THIS host without killing anything.

    queuectl drain [--report-every S]   stop claiming; running tasks finish. Prints "host: N running" every S seconds
                                        (default 5) until N is 0; S=0 returns at once
    queuectl resume                     claim again
    queuectl reload                     re-read .env (proton: QUEUE_MAX_WORKERS + claim gates; worker: DISPATCH_*)
    queuectl status                     daemon state and Processing per host (proton) / running processes (worker)

On proton the verbs go to the queue daemon's socket (QUEUE_SOCKET_PATH, group pipeline, no sudo); a daemon that
predates the channel gets its signal contract instead (SIGUSR1 / SIGUSR2 / SIGHUP) when the caller may signal it.
On a worker host they signal pipeline-dispatch-worker. The all-hosts row pause is still `drain_queue`.
"""

import argparse
import json
import os
import re
import signal
import socket
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

pipeline_dir = Path(__file__).parent.parent.parent
sys.path.insert(0, str(pipeline_dir))

from pipeline.const import MAIN_HOST, QUEUE_SOCKET_PATH, SCHEDULER_DB_PATH, TASK_STATUS_PROCESSING
from pipeline.services.scheduler import Scheduler

QUEUE_UNIT = "pipeline-queue"
WORKER_UNIT = "pipeline-dispatch-worker"
SIGNALS = {"drain": signal.SIGUSR1, "resume": signal.SIGUSR2, "reload": signal.SIGHUP}
TASK_CMD = re.compile(r"python\S* \S*cli/(data_reduction|crossfilter|preprocess) ")


def daemon_call(socket_path, command):
    """One command to the queue daemon: its JSON state; {} when a daemon listens but predates the control channel;
    None when nothing listens there."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(5.0)
            sock.connect(socket_path)
            sock.sendall(f"{command}\n".encode())
            reply = sock.recv(4096)
    except (FileNotFoundError, ConnectionRefusedError, OSError):
        return None
    try:
        state = json.loads(reply) if reply else {}
    except ValueError:
        state = {}
    return state if isinstance(state, dict) else {}


def send_signal(unit, action):
    """The signal contract for a daemon without the socket channel; "ERROR ..." when it could not be sent."""
    try:
        pid = int(subprocess.run(["systemctl", "show", "-p", "MainPID", "--value", unit], capture_output=True, text=True).stdout.strip() or 0)
    except (OSError, ValueError):
        pid = 0
    if not pid:
        return f"ERROR: no running {unit} here"
    try:
        os.kill(pid, SIGNALS[action])
    except PermissionError:
        return f"ERROR: {unit} (pid {pid}) runs as another user: sudo systemctl kill -s {SIGNALS[action].name} --kill-who=main {unit}"
    return f"{action} -> {unit} (pid {pid}) by {SIGNALS[action].name}"


def db_processing(db_path):
    """Processing rows per host from the scheduler DB (the origin's '' rows count as the origin)."""
    with sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=Scheduler.DB_BUSY_TIMEOUT) as conn:
        return dict(conn.execute(
            "SELECT COALESCE(NULLIF(dispatch, ''), ?), COUNT(*) FROM scheduler WHERE status = ? GROUP BY 1",
            (MAIN_HOST, TASK_STATUS_PROCESSING)).fetchall())


def local_running():
    """Reduction processes on this host — a worker has no scheduler DB."""
    n = 0
    for pid in os.listdir("/proc"):
        if pid.isdigit():
            try:
                with open(f"/proc/{pid}/cmdline", "rb") as f:
                    n += bool(TASK_CMD.search(f.read().replace(b"\0", b" ").decode(errors="replace")))
            except OSError:
                pass
    return n


def describe(state):
    return f"{'draining' if state['draining'] else 'claiming'}, {state['running']} running / {state['slots']} slots"


def main():
    parser = argparse.ArgumentParser(description="Drain, resume, reload or inspect the reduction queue on this host.")
    parser.add_argument("action", choices=["drain", "resume", "reload", "status"])
    parser.add_argument("--report-every", type=float, default=5.0, metavar="S", help="drain: seconds between report lines, 0 = none (default 5)")
    parser.add_argument("--socket", default=QUEUE_SOCKET_PATH, help="queue daemon socket (default: configured path)")
    parser.add_argument("--db", default=SCHEDULER_DB_PATH, help="scheduler DB (default: configured path)")
    args = parser.parse_args()

    state = daemon_call(args.socket, "status") if args.socket else None
    on_origin = state is not None                        # a queue daemon listens on the socket: this is the origin
    has_channel = bool(state) and "draining" in state    # and it understands more than `wake`
    host = MAIN_HOST if on_origin else socket.gethostname().split(".")[0]
    have_db = bool(args.db) and os.path.exists(args.db)
    running = (lambda: db_processing(args.db).get(host, 0)) if have_db else local_running

    if args.action == "status":
        if has_channel:
            print(f"{MAIN_HOST} queue daemon: {describe(state)}")
        elif on_origin:
            print(f"{MAIN_HOST} queue daemon: listening, without the socket control channel (restart it after the update)")
        if have_db:
            print("processing by host: " + (", ".join(f"{h}={n}" for h, n in sorted(db_processing(args.db).items())) or "nothing"))
        else:
            print(f"{host}: {local_running()} reduction process(es) running")
        return 0

    if has_channel:
        reply = daemon_call(args.socket, args.action)
        if not reply or "draining" not in reply:
            print(f"ERROR: queue daemon replied {reply!r}", file=sys.stderr)
            return 1
        print(f"{MAIN_HOST}: {args.action} -> {describe(reply)}", flush=True)
    else:
        if on_origin:
            print(f"queue daemon predates the socket control channel: using its signal contract; restart {QUEUE_UNIT} after the update", flush=True)
        message = send_signal(QUEUE_UNIT if on_origin else WORKER_UNIT, args.action)
        if message.startswith("ERROR: no running") and not on_origin:
            message = f"ERROR: no queue daemon on {args.socket} and no running {WORKER_UNIT} here"
        if message.startswith("ERROR"):
            print(message, file=sys.stderr)
            return 1
        print(f"{host}: {message}", flush=True)

    if args.action == "drain" and args.report_every > 0:
        t0 = time.monotonic()
        while True:
            n = running()
            print(f"  [{int((time.monotonic() - t0) // 60):02d}:{int((time.monotonic() - t0) % 60):02d}] {host}: {n} running", flush=True)
            if n == 0:
                print(f"{host}: drained")
                break
            time.sleep(args.report_every)
    return 0


if __name__ == "__main__":
    sys.exit(main())
