#!/home/pipeline-stable/.conda/envs/pipeline/bin/python
"""
Dispatch pipeline worker.

One process on the worker host:
  claim on proton -> run preprocess/data_reduction here -> mark_done on proton

Every scheduler write executes ON proton via cli/scheduler_rpc over ssh. The worker never
opens the scheduler sqlite: WAL's index is coherent only within one host, and opening it
over NFS hands the same task to two hosts (measured).

Environment:
  PROTON_SSH              user@host for the origin (default pipeline-stable@<MAIN_HOST_ADDRESS>)
  PROTON_SSH_PORT         ssh port (default 45204)
  PROTON_SCHEDULER_RPC    path to cli/scheduler_rpc on proton
  DISPATCH_SERVER_NAME    worker name stored in the origin dispatch column (default: hostname)
  DISPATCH_CONFIG_TYPES   comma-separated config_type whitelist (default "science"; "any" for no limit)
  DISPATCH_INPUT_TYPE     relabel each claimed row with this scheduler input_type (default: leave it alone)
  DISPATCH_MAX_WORKERS    parallel jobs (default 5)
  DISPATCH_POLL_INTERVAL  seconds between polls (default 5)
  DISPATCH_PREFETCH       extra tasks to claim ahead of a free slot (default 0 = never claim ahead)

Signals: SIGHUP reloads DISPATCH_MAX_WORKERS, DISPATCH_INPUT_TYPE and
DISPATCH_POLL_INTERVAL from .env; SIGUSR1 drains (stop claiming, let running configs
finish), SIGUSR2 resumes, SIGTERM/SIGINT stop now (running configs are terminated and
their rows released).
"""

from __future__ import annotations

import argparse
import json
import logging
import os
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

from dotenv import load_dotenv

pipeline_dir = Path(__file__).parent.parent.parent
sys.path.insert(0, str(pipeline_dir))

from pipeline.const import (
    FAILURE_RETURN_CODE,
    SUCCESS_RETURN_CODE,
    EMPTY_INPUT_AFTER_SANITY_REJECTION_RETURN_CODE,
    MAIN_HOST_ADDRESS,
)
from pipeline.services.scheduler import Scheduler

DEFAULT_POLL_INTERVAL = 5.0
DEFAULT_MAX_WORKERS = 5
# Claiming ahead marks rows Processing before they run; a SIGKILL then strands them, so default to none.
DEFAULT_PREFETCH = 0
# Deliberately narrow while a worker is new; no stage needs a GPU, so widen when ready.
DEFAULT_CONFIG_TYPES = "science"
RPC_TIMEOUT = 60.0
# Shutdown runs against TimeoutStopSec, so its RPCs get a much shorter leash than a live claim.
SHUTDOWN_RPC_TIMEOUT = 10.0
SHUTDOWN_GRACE_SECONDS = 10.0
SHUTDOWN_KILL_REAP_SECONDS = 5.0
RESPONSE_TAG = "__SCHEDULER_RPC__"
# Outcomes a run reports for itself; anything else means it was stopped from outside.
REPORTED_RETURN_CODES = (SUCCESS_RETURN_CODE, FAILURE_RETURN_CODE, EMPTY_INPUT_AFTER_SANITY_REJECTION_RETURN_CODE)

logger = logging.getLogger("pipeline.dispatch_worker")


class ProtonScheduler:
    """Scheduler writes executed on proton over ssh."""

    def __init__(self, ssh, port, rpc_path):
        self.ssh_cmd = ["ssh", "-p", str(port), "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", ssh, rpc_path]
        self.timeout = RPC_TIMEOUT

    def _call(self, method, **args):
        proc = subprocess.run(
            self.ssh_cmd,
            input=json.dumps({"method": method, "args": args}),
            capture_output=True,
            text=True,
            timeout=self.timeout,
        )
        for line in proc.stdout.splitlines():
            if line.startswith(RESPONSE_TAG):
                response = json.loads(line[len(RESPONSE_TAG) :])
                if not response["ok"]:
                    raise RuntimeError(f"scheduler_rpc {method}: {response['error']}")
                return response["result"]
        raise RuntimeError(f"scheduler_rpc {method}: no response (rc={proc.returncode}) {proc.stderr.strip()[:300]}")

    def claim(self, server, config_types, input_type):
        return self._call("claim", server=server, config_types=config_types, input_type=input_type)

    def claim_many(self, server, config_types, input_type, count):
        return self._call("claim_many", server=server, config_types=config_types, input_type=input_type, count=count)

    def set_pid(self, index, server, pid):
        return self._call("set_pid", index=index, server=server, pid=pid)

    def release(self, index, server):
        return self._call("release", index=index, server=server)

    def mark_done(self, index, return_code):
        return self._call("mark_done", index=index, return_code=return_code)


class DispatchWorker:
    def __init__(
        self, scheduler, server_name, max_workers, config_types=None, input_type=None, prefetch=0,
        poll_interval=DEFAULT_POLL_INTERVAL,
    ):
        self.scheduler = scheduler
        self.server_name = server_name
        self.max_workers = max_workers
        self.config_types = config_types
        self.input_type = input_type
        self.prefetch = max(0, int(prefetch))
        self.poll_interval = poll_interval
        self._stop = False
        self._drain = False
        self._drained_logged = False
        self._reload_requested = False
        self._rpc_down = False
        self._active: dict[int, dict] = {}  # pid -> {index, config, proc}
        self._pending: list[dict] = []  # claimed but not yet started; only non-empty when prefetch > 0

    def _finish(self, entry, return_code):
        """Report a finished run with its RAW return code; 2 (Rejected) is a normal outcome."""
        self.scheduler.mark_done(entry["index"], return_code)
        logger.info("Finished index %s (%s) rc=%s", entry["index"], os.path.basename(entry["config"]), return_code)

    def _reap_finished(self):
        for pid in list(self._active):
            entry = self._active[pid]
            return_code = entry["proc"].poll()
            if return_code is None:
                continue
            try:
                self._finish(entry, return_code)
            except Exception:
                logger.exception("Could not mark index %s done; will retry next poll", entry["index"])
                continue
            del self._active[pid]

    def _start(self, task):
        index = task["index"]
        try:
            cmd = Scheduler.build_command(task["config"], task["config_type"], task["input_type"], task["kwargs"])
            proc = subprocess.Popen(cmd, start_new_session=True)
        except Exception:
            self.scheduler.release(index, self.server_name)
            raise

        # Track before any further RPC. Releasing a claim whose child is alive lets the origin
        # start a second reduction over the same outputs; a row left at pid=0 costs nothing.
        self._active[proc.pid] = {"index": index, "config": task["config"], "proc": proc}
        try:
            self.scheduler.set_pid(index, self.server_name, proc.pid)
        except Exception:
            logger.exception("Could not record pid for index %s on proton; the row keeps pid=0", index)
        logger.info("Started index %s pid=%s (%s)", index, proc.pid, os.path.basename(task["config"]))

    def _fill(self):
        """Claim every free slot in one RPC and start them; the poll interval stops gating the fill rate."""
        if self._stop or self._drain:
            return 0
        free = self.max_workers - len(self._active)
        if free <= 0:
            return 0

        tasks, self._pending = self._pending, []
        if len(tasks) < free:
            try:
                tasks += self.scheduler.claim_many(
                    self.server_name, self.config_types, self.input_type, free - len(tasks) + self.prefetch
                ) or []
            except Exception:
                self._pending = tasks
                raise

        started = 0
        try:
            while tasks and started < free and not self._stop:
                self._start(tasks.pop(0))
                started += 1
        finally:
            self._pending = tasks  # anything unstarted stays claimed; released on drain or shutdown
        return started

    def _release_pending(self):
        """Hand back claims that were prefetched but never started, so they do not sit Processing."""
        keep = []
        for task in self._pending:
            try:
                self.scheduler.release(task["index"], self.server_name)
            except Exception:
                logger.exception("Could not release prefetched index %s; leaving it claimed", task["index"])
                keep.append(task)
        if self._pending:
            logger.info("Released %d prefetched claim(s)", len(self._pending) - len(keep))
        self._pending = keep

    def run_once(self):
        self._reap_finished()
        if (self._drain or self._stop) and self._pending:
            self._release_pending()
        started = self._fill()
        if self._drain and not self._active and not self._pending and not self._drained_logged:
            self._drained_logged = True
            logger.info("Drained: 0 running, 0 claimed. Safe to stop or restart this unit.")
        return {"active": len(self._active), "max_workers": self.max_workers, "started": started}

    def _reload_config(self):
        """Apply mutable settings at a loop boundary, never from the signal handler."""
        try:
            load_dotenv(pipeline_dir / ".env", override=True)
            max_workers = int(os.environ.get("DISPATCH_MAX_WORKERS", DEFAULT_MAX_WORKERS))
            poll_interval = float(os.environ.get("DISPATCH_POLL_INTERVAL", DEFAULT_POLL_INTERVAL))
            if max_workers < 0:
                raise ValueError("DISPATCH_MAX_WORKERS must be >= 0")
            if poll_interval < 0:
                raise ValueError("DISPATCH_POLL_INTERVAL must be >= 0")
        except (TypeError, ValueError):
            logger.exception("Dispatch reload rejected; retaining current settings")
            return

        input_type = os.environ.get("DISPATCH_INPUT_TYPE", "") or None
        old = (self.max_workers, self.input_type, self.poll_interval)
        self.max_workers = max_workers
        self.input_type = input_type
        self.poll_interval = poll_interval
        logger.info(
            "Dispatch reload applied: max_workers %s -> %s, input_type %s -> %s, poll_interval %s -> %s",
            old[0], self.max_workers, old[1] or "(unchanged)", self.input_type or "(unchanged)",
            old[2], self.poll_interval,
        )

    def request_reload(self, *_args):
        """Schedule a .env reload; signal handlers must not perform I/O or mutate worker state."""
        self._reload_requested = True

    def run_forever(self):
        logger.info(
            "Dispatch worker started (server=%s, max_workers=%d, config_types=%s, input_type=%s)",
            self.server_name,
            self.max_workers,
            self.config_types or "any",
            self.input_type or "(unchanged)",
        )
        if self.prefetch:
            logger.warning("Prefetch is %d: rows are claimed before a slot frees and strand if this host is killed",
                           self.prefetch)
        while not self._stop:
            if self._reload_requested:
                self._reload_requested = False
                self._reload_config()
            try:
                self.run_once()
            except Exception:
                logger.exception("Worker iteration failed")
            time.sleep(self.poll_interval)
        self._shutdown()
        logger.info("Dispatch worker stopped")

    def _shutdown(self):
        """Report what finished, hand back what died, keep the claim on anything still alive."""
        self.scheduler.timeout = SHUTDOWN_RPC_TIMEOUT
        self._release_pending()
        self._settle_stopped()  # honours _rpc_down, unlike _reap_finished's per-entry retry
        for entry in self._active.values():
            entry["proc"].terminate()

        deadline = time.monotonic() + SHUTDOWN_GRACE_SECONDS
        while self._active and time.monotonic() < deadline:
            self._settle_stopped()
            if self._active:
                time.sleep(0.5)

        for entry in list(self._active.values()):
            entry["proc"].kill()
            try:
                entry["proc"].wait(timeout=SHUTDOWN_KILL_REAP_SECONDS)  # a kill without a wait leaves a zombie
            except subprocess.TimeoutExpired:
                pass
        self._settle_stopped()

        for entry in self._active.values():
            logger.critical(
                "index %s (pid %s) survived SIGKILL, most likely stuck in NFS I/O; its claim stays with %s "
                "so nothing reruns it while it may still be writing",
                entry["index"],
                entry["proc"].pid,
                self.server_name,
            )

    def _settle_stopped(self):
        """Only ever settles a child confirmed dead: poll() is None for a moment even after SIGKILL."""
        for pid in list(self._active):
            entry = self._active[pid]
            return_code = entry["proc"].poll()
            if return_code is None or self._rpc_down:
                continue
            try:
                if return_code in REPORTED_RETURN_CODES:
                    self._finish(entry, return_code)
                else:
                    self.scheduler.release(entry["index"], self.server_name)
                    logger.info("Released index %s back to Ready (rc=%s)", entry["index"], return_code)
            except Exception:
                # proton is unreachable; further RPCs would each burn a full timeout for nothing.
                self._rpc_down = True
                logger.exception("Could not settle index %s on proton; leaving it claimed", entry["index"])
                continue
            del self._active[pid]

    def drain(self, *_args):
        """Stop claiming; let every running config finish. The daemon stays up and idle."""
        if not self._drain:
            self._drain = True
            self._drained_logged = False
            logger.info("Drain requested: no new claims; %d running config(s) will finish", len(self._active))

    def resume(self, *_args):
        if self._drain:
            self._drain = False
            self._drained_logged = False
            logger.info("Drain cleared: claiming resumed")

    def stop(self, *_args):
        self._stop = True


def parse_args():
    parser = argparse.ArgumentParser(description="Dispatch pipeline worker (claims from proton over ssh)")
    parser.add_argument("--ssh", default=os.environ.get("PROTON_SSH", f"pipeline-stable@{MAIN_HOST_ADDRESS}"))
    parser.add_argument("--ssh-port", default=os.environ.get("PROTON_SSH_PORT", "45204"))
    parser.add_argument(
        "--rpc-path",
        default=os.environ.get("PROTON_SCHEDULER_RPC", "/home/pipeline-stable/pipeline/pipeline/cli/scheduler_rpc"),
    )
    parser.add_argument("--server-name", default=os.environ.get("DISPATCH_SERVER_NAME", socket.gethostname()))
    parser.add_argument("--input-type", default=os.environ.get("DISPATCH_INPUT_TYPE", "") or None,
                        help="Relabel each claimed row with this scheduler input_type")
    parser.add_argument("--config-types", default=os.environ.get("DISPATCH_CONFIG_TYPES", DEFAULT_CONFIG_TYPES))
    parser.add_argument(
        "--max-workers", type=int, default=int(os.environ.get("DISPATCH_MAX_WORKERS", DEFAULT_MAX_WORKERS))
    )
    parser.add_argument(
        "--poll-interval", type=float, default=float(os.environ.get("DISPATCH_POLL_INTERVAL", DEFAULT_POLL_INTERVAL))
    )
    parser.add_argument(
        "--prefetch", type=int, default=int(os.environ.get("DISPATCH_PREFETCH", DEFAULT_PREFETCH))
    )
    parser.add_argument("--check", action="store_true", help="Verify the proton connection and exit")
    return parser.parse_args()


def main():
    logging.basicConfig(level=logging.INFO, format="%(asctime)s - %(name)s - %(levelname)s - %(message)s")
    args = parse_args()

    scheduler = ProtonScheduler(args.ssh, args.ssh_port, args.rpc_path)
    config_types = [t.strip() for t in args.config_types.split(",") if t.strip()] or None
    if config_types == ["any"]:
        config_types = None

    if args.check:
        # A claim of a config_type nothing uses proves the whole path without taking work.
        scheduler.claim(args.server_name, ["__connection_check__"], None)
        print(f"OK: scheduler_rpc reachable on {args.ssh}")
        return

    worker = DispatchWorker(
        scheduler, args.server_name, args.max_workers, config_types, args.input_type, args.prefetch,
        args.poll_interval,
    )
    signal.signal(signal.SIGTERM, worker.stop)
    signal.signal(signal.SIGINT, worker.stop)
    signal.signal(signal.SIGHUP, worker.request_reload)
    signal.signal(signal.SIGUSR1, worker.drain)
    signal.signal(signal.SIGUSR2, worker.resume)
    worker.run_forever()


if __name__ == "__main__":
    main()
