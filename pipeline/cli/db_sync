#!/home/pipeline-stable/.conda/envs/pipeline/bin/python

import argparse
import signal
import sys

from pipeline.services.database.sync import sync_config, sync_images


def signal_handler(sig, frame):
    print("\nTerminate process")
    sys.exit(0)


signal.signal(signal.SIGINT, signal_handler)

if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description=(
            "Post-hoc DB sync. FITS images are handled as a batch: each one's sciproc config "
            "is reconciled first (process_status progress/status from the config flags), its "
            "id is stamped on the image_qa row, image_qa_dependency is rebuilt, and the edges "
            "are rolled up into process_status_dependency. A config given directly is "
            "reconciled on its own."
        ),
        epilog=(
            "Examples:\n"
            "  %(prog)s /path/to/UDS_m525_coadd.fits\n"
            "  %(prog)s /path/to/UDS_m525.yml\n"
            "  %(prog)s /path/dir/*.fits /path/to/UDS_m525.yml"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("paths", nargs="+", help=".fits (image_qa + dependencies) or .yml (process_status)")
    args = parser.parse_args()

    configs = [p for p in args.paths if p.endswith((".yml", ".yaml"))]
    images = [p for p in args.paths if p not in configs]

    n_fail = 0

    # images go through sync_images, which resolves each one's config first so the
    # process_status id lands on its image_qa row, then rolls the edges up per config
    if images:
        report = sync_images(images)
        for yml, info in report["configs"].items():
            rollup = info.get("n_rollup_edges", 0)
            print(
                f"[OK] {yml}: process_status id={info['process_status_id']} -> "
                f"{info['status'] or 'no completed stage; row left as-is'}"
                f" ({info['n_images']} images, {rollup} rollup edges)"
            )
        for path, info in report["images"].items():
            print(f"[OK] {path}: qa_id={info['qa_id']}, {info['n_dependency_rows']} dependency rows")
        for path, err in report["errors"].items():
            print(f"[FAIL] {path}: {err}", file=sys.stderr)
            n_fail += 1

    for path in configs:
        try:
            ps_id, status = sync_config(path)
            print(f"[OK] {path}: process_status id={ps_id} -> {status or 'no completed stage; row left as-is'}")
        except Exception as e:
            print(f"[FAIL] {path}: {e}", file=sys.stderr)
            n_fail += 1

    sys.exit(1 if n_fail else 0)
