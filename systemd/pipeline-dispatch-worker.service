[Unit]
Description=Pipeline dispatch worker (claims tasks from the origin scheduler)
After=network-online.target remote-fs.target
RequiresMountsFor=/lyman/data1 /lyman/data2 /balmer/data1

[Service]
UMask=0002
Type=simple
User=pipeline-worker
Group=pipeline
WorkingDirectory=/opt/pipeline
Environment="PATH=/opt/conda/envs/pipeline/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/opt/pipeline"
EnvironmentFile=-/opt/pipeline/.env
Environment=ORIGIN_SCHEDULER_DB_PATH=/mnt/origin/var/db/scheduler.db
Environment=DISPATCH_SERVER_NAME=%H
Environment=DISPATCH_MAX_WORKERS=5
Environment=DISPATCH_POLL_INTERVAL=5
ExecStart=/opt/conda/envs/pipeline/bin/python3 /opt/pipeline/pipeline/cli/dispatch_worker_daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pipeline-dispatch-worker

[Install]
WantedBy=multi-user.target
