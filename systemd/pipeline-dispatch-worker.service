# TEMPLATE, one worker host per installation. dispatch/setup_dispatch_worker.sh substitutes the
# @NAME@ placeholders and installs the result; do not symlink this file into /etc/systemd/system.
[Unit]
Description=Pipeline dispatch worker (claims tasks from the main host's scheduler over ssh)
After=network-online.target remote-fs.target
RequiresMountsFor=/lyman/data1 /lyman/data2

[Service]
UMask=0002
Type=simple
# Only the daemon gets SIGTERM; without this systemd kills every reduction in the cgroup at t=0,
# which pre-empts the shutdown path below and makes a graceful drain impossible.
KillMode=mixed
User=@USER@
Group=pipeline
WorkingDirectory=@PIPELINE_ROOT@
Environment="PATH=@PYTHON_BIN_DIR@:/usr/local/bin:/usr/bin:/bin"
# Thread-pool caps for every reduction this worker spawns (see pipeline/__init__.py).
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
Environment=VECLIB_MAXIMUM_THREADS=1
Environment=NUMBA_NUM_THREADS=8
EnvironmentFile=@PIPELINE_ROOT@/.env
# DISPATCH_SERVER_NAME / _CONFIG_TYPES / _INPUT_TYPE / _MAX_WORKERS / _POLL_INTERVAL all come from
# the EnvironmentFile above. Keep them there, not here: systemd caches this file, so an Environment=
# line needs `daemon-reload` to change, while .env is re-read on every start.
ExecStart=@PYTHON_BIN_DIR@/python3 @PIPELINE_ROOT@/pipeline/cli/dispatch_worker_daemon
Restart=always
RestartSec=10
# Stop path: settle -> SIGTERM + 10 s grace -> SIGKILL + 5 s reap -> settle, each RPC capped at
# SHUTDOWN_RPC_TIMEOUT and abandoned wholesale once the main host stops answering.
TimeoutStopSec=120
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pipeline-dispatch-worker

[Install]
WantedBy=multi-user.target
