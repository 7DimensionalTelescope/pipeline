[Unit]
Description=Send final ToO notices for settled nights
After=network.target

[Service]
UMask=0002
Type=oneshot
User=pipeline-stable
Group=pipeline
WorkingDirectory=/home/pipeline-stable/pipeline
Environment="PATH=/home/pipeline-stable/.conda/envs/pipeline/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/pipeline-stable/pipeline/.env
ExecStart=/home/pipeline-stable/.conda/envs/pipeline/bin/python3 /home/pipeline-stable/pipeline/pipeline/cli/too_final_sweep
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pipeline-too-final-sweep
NoNewPrivileges=true
PrivateTmp=true
