[Unit]
Description=Pipeline Queue Manager Daemon
After=network.target pipeline-trigger.service
PartOf=pipeline-trigger.service

[Service]
UMask=0002
Type=simple
User=pipeline-stable
Group=pipeline
WorkingDirectory=/home/pipeline-stable/pipeline
Environment="PATH=/home/pipeline-stable/.conda/envs/pipeline/bin:/usr/local/bin:/usr/bin:/bin"
# Thread-pool caps for every worker this daemon spawns (see pipeline/__init__.py).
# Covers scripts that import numpy before pipeline, where the in-code default is too late.
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
Environment=VECLIB_MAXIMUM_THREADS=1
Environment=NUMBA_NUM_THREADS=8
EnvironmentFile=/home/pipeline-stable/pipeline/.env
ExecStart=/home/pipeline-stable/.conda/envs/pipeline/bin/python3 /home/pipeline-stable/pipeline/pipeline/cli/queue_daemon
Restart=always
RestartSec=10
# Graceful stop is designed to finish in <=25 s (SHUTDOWN_* budgets in services/queue.py);
# 45 s covers it with margin and halves the wait when the daemon is beyond saving.
TimeoutStopSec=45
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pipeline-queue

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
